# Copy this file to .env and fill in real values. Never commit .env itself.

# LLM proxy connection. Without PROXY_API_KEY set, the API still runs
# end-to-end (routing, guardrails, storage) but returns a
# "[simulated reply]" instead of calling the model.
PROXY_API_KEY=your-api-key-here
PROXY_BASE_URL=https://your-proxy-endpoint.example.com
PROXY_MODEL_NAME=claude-sonnet-5

# GitHub integration used by the git-mode tool calls
GITHUB_PERSONAL_ACCESS_TOKEN=your-github-token-here
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repo-name

# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
